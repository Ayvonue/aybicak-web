# Environment Variables for Ay Bıçak

# İyzico kart ödemesi — https://merchant.iyzipay.com/
# Anahtarlar girilip NEXT_PUBLIC_IYZICO_ENABLED=true yapılınca checkout'ta
# "Kredi / Banka Kartı" seçeneği görünür.
IYZICO_API_KEY=your_api_key
IYZICO_SECRET_KEY=your_secret_key
# Sandbox testi için: https://sandbox-api.iyzipay.com (varsayılan: production)
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
NEXT_PUBLIC_IYZICO_ENABLED=false

# Resend e-posta servisi (üyelik doğrulama + sipariş e-postaları için zorunlu)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Doğrulanmış kendi domaininizle gönderim için (yoksa Resend test domaini kullanılır)
EMAIL_FROM="AYBIÇAK <no-reply@aybicak.com>"
# Yeni sipariş bildirimlerinin gönderileceği adres (sizin e-postanız)
ORDER_NOTIFY_EMAIL=siparis@aybicak.com
# İletişim formu mesajlarının gönderileceği adres (yoksa ORDER_NOTIFY_EMAIL kullanılır)
CONTACT_EMAIL=info@aybicak.com
# Bülten abonelik bildirimlerinin gönderileceği adres (yoksa ORDER_NOTIFY_EMAIL kullanılır)
NEWSLETTER_EMAIL=bulten@aybicak.com

# Havale / EFT bilgileri (checkout başarı ekranında gösterilir)
NEXT_PUBLIC_BANK_NAME="Ziraat Bankası"
NEXT_PUBLIC_BANK_OWNER="Ay Bıçak"
NEXT_PUBLIC_BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yönetim paneli girişi (/admin). Üçü de zorunlu, aksi halde giriş kapalıdır.
# ADMIN_SESSION_SECRET: uzun rastgele bir dize (örn: openssl rand -hex 32)
ADMIN_EMAIL=admin@aybicak.com
ADMIN_PASSWORD=guclu-bir-sifre-belirleyin
ADMIN_SESSION_SECRET=rastgele-uzun-gizli-anahtar-degistirin

# Veritabanı (Neon/Vercel Postgres) — ürün & sipariş kalıcılığı ve admin CRUD için
# Vercel'de: Storage → Postgres/Neon bağlayınca otomatik eklenir.
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# Google Analytics 4 (opsiyonel — ölçüm ID'si girilince aktifleşir)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Blob (admin ürün görseli yükleme için — Vercel'de Blob store bağlayınca otomatik gelir)
# BLOB_READ_WRITE_TOKEN=...

# Müşteri oturum imzası (opsiyonel; yoksa ADMIN_SESSION_SECRET kullanılır)
# CUSTOMER_SESSION_SECRET=...
