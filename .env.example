# Environment Variables for Ay Bıçak

# İyzico kart ödemesi — https://merchant.iyzipay.com/
# Anahtarlar girilip NEXT_PUBLIC_IYZICO_ENABLED=true yapılınca checkout'ta
# "Kredi / Banka Kartı" seçeneği görünür.
IYZICO_API_KEY=your_api_key
IYZICO_SECRET_KEY=your_secret_key
# Sandbox testi için: https://sandbox-api.iyzipay.com (varsayılan: production)
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
NEXT_PUBLIC_IYZICO_ENABLED=false

# Resend e-posta servisi (üyelik doğrulama + sipariş e-postaları için zorunlu)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Doğrulanmış kendi domaininizle gönderim için (yoksa Resend test domaini kullanılır)
EMAIL_FROM="AYBIÇAK <no-reply@aybicak.com>"
# Yeni sipariş bildirimlerinin gönderileceği adres (sizin e-postanız)
ORDER_NOTIFY_EMAIL=siparis@aybicak.com

# Havale / EFT bilgileri (checkout başarı ekranında gösterilir)
NEXT_PUBLIC_BANK_NAME="Ziraat Bankası"
NEXT_PUBLIC_BANK_OWNER="Ay Bıçak"
NEXT_PUBLIC_BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
